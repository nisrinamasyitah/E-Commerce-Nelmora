# ---------------------------------------------------------------------------
# For running on YOUR COMPUTER (copy this file to .env).
# For Netlify, add the same names under Site configuration → Environment variables.
# ---------------------------------------------------------------------------

# Admin login for /admin (required: the admin area is locked until this is set)
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

# Database. Leave both empty on your computer: it uses a local file, data/shop.db.
# On Netlify they are required. Get them from your free Turso database (turso.tech).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local server only
PORT=3002
# 127.0.0.1 = only this computer. 0.0.0.0 = reachable from your Wi-Fi.
HOST=127.0.0.1

# The public address of the shop, e.g. https://nelmoramy.netlify.app (used for payment return links)
PUBLIC_URL=http://localhost:3002

# Online payment (optional). Leave empty to accept bank transfer / DuitNow only.
# Get keys at https://dashboard.stripe.com/apikeys. Stripe supports card, FPX and GrabPay in Malaysia.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, endpoint: <PUBLIC_URL>/api/stripe/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
