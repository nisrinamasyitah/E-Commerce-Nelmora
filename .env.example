# Copy this file to .env and fill it in.

# Admin login for /admin (required: the admin area is locked until this is set)
ADMIN_PASSWORD=
# Long random string used to sign admin sessions
SESSION_SECRET=

# Server
PORT=3002
# 127.0.0.1 = only this computer. 0.0.0.0 = reachable from your Wi-Fi / the internet.
HOST=127.0.0.1
# The public address of the shop (used for Stripe return links), e.g. https://nelmoraparfums.com
PUBLIC_URL=http://localhost:3002

# Online payment (optional). Leave empty to accept bank transfer / DuitNow only.
# Get keys at https://dashboard.stripe.com/apikeys. Stripe supports card, FPX and GrabPay in Malaysia.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, endpoint: <PUBLIC_URL>/api/stripe/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
